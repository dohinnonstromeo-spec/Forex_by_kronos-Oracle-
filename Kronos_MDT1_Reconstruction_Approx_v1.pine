//@version=6
strategy("MDT 1 · Reconstitution non officielle OB/FVG MTF", shorttitle="MDT-reconst.", overlay=true, pyramiding=0, initial_capital=1000, currency=currency.USD, default_qty_type=strategy.fixed, default_qty_value=1, commission_type=strategy.commission.cash_per_contract, commission_value=0, slippage=1, process_orders_on_close=false, calc_on_order_fills=true, use_bar_magnifier=true, max_labels_count=250, max_boxes_count=80, max_lines_count=80)

// Approximation personnelle fondée sur les captures et les exemples de signaux
// visibles. Ce n'est pas le code propriétaire de MDT 1.

string G_MTF = "01 · Tendance multi-unités"
string G_SETUP = "02 · OB, FVG et entrée limite"
string G_RISK = "03 · Sorties et risque"
string G_VIEW = "04 · Affichage mobile"

int atrLen = input.int(14, "ATR M5", minval=2, maxval=100, group=G_SETUP)
int bosLookback = input.int(5, "Cassure structurelle (barres)", minval=2, maxval=30, group=G_SETUP)
int obLookback = input.int(5, "Bougies pour trouver l'OB", minval=1, maxval=20, group=G_SETUP)
float displacementAtr = input.float(0.60, "Corps minimal du déplacement (x ATR)", minval=0.1, maxval=3, step=0.05, group=G_SETUP)
int orderExpiryBars = input.int(12, "Expiration de l'ordre limite (M5)", minval=1, maxval=48, group=G_SETUP)
int minTrendVotes = input.int(2, "Confirmations tendance minimum / 4", minval=2, maxval=4, group=G_MTF)
float stopAtrBuffer = input.float(0.10, "Marge derrière OB/FVG (x ATR)", minval=0.01, maxval=1, step=0.01, group=G_RISK)
float maxStopAtr = input.float(3.0, "Risque maximal (x ATR)", minval=0.5, maxval=10, step=0.25, group=G_RISK)
float tp1R = input.float(0.67, "TP1 · fermer 50 % (R)", minval=0.2, maxval=5, step=0.01, group=G_RISK)
float tp2R = input.float(2.50, "TP2 · fermer le reste (R)", minval=0.5, maxval=10, step=0.1, group=G_RISK)
int maxHoldBars = input.int(6, "Sortie temps (barres M5)", minval=1, maxval=100, group=G_RISK)
float orderQty = input.float(1.0, "Quantité Strategy Tester", minval=0.001, step=0.01, group=G_RISK, tooltip="Unité de simulation TradingView, pas le lot Deriv.")
float spreadEstimateUsd = input.float(0.15, "Spread estimé XAUUSD ($)", minval=0, maxval=10, step=0.01, group=G_RISK)
int slippageTicks = input.int(1, "Slippage simulé (ticks par côté)", minval=0, maxval=100, group=G_RISK)
float commissionRoundTrip = input.float(0.0, "Commission aller-retour ($)", minval=0, maxval=100, step=0.01, group=G_RISK)
float maxCostR = input.float(0.15, "Coût maximum estimé (R)", minval=0, maxval=1, step=0.01, group=G_RISK)
bool onlyXau = input.bool(true, "Signaler seulement XAUUSD", group=G_SETUP)
bool showZones = input.bool(true, "Tracer OB et FVG", group=G_VIEW)
bool showPlan = input.bool(true, "Tracer Entrée, SL et TP", group=G_VIEW)
bool showLabels = input.bool(true, "Étiquettes de setup", group=G_VIEW)

bool isM5 = timeframe.isminutes and timeframe.multiplier == 5
bool isXau = str.contains(str.upper(syminfo.ticker), "XAU")
if barstate.isfirst and not isM5
    runtime.error("Cette reconstruction fonctionne sur un graphique M5.")
if barstate.isfirst and onlyXau and not isXau
    runtime.error("Choisis un graphique XAUUSD ou désactive le filtre XAUUSD.")

f_closedTrend() =>
    float e20 = ta.ema(close, 20)
    float e50 = ta.ema(close, 50)
    close[1] > e20[1] and e20[1] > e50[1] and e20[1] > e20[3] ? 1 :
      close[1] < e20[1] and e20[1] < e50[1] and e20[1] < e20[3] ? -1 : 0

f_lastBullOB() =>
    float a = ta.atr(atrLen)
    bool impulse = close > open and math.abs(close - open) >= a * displacementAtr and
      close > ta.highest(high[1], bosLookback) and low > high[2]
    int offset = na
    for k = 1 to obLookback
        if na(offset) and close[k] < open[k]
            offset := k
    float candidate = na(offset) ? na : (low[offset] + open[offset]) / 2.0
    ta.valuewhen(impulse and not na(candidate), candidate, 0)[1]

f_lastBearOB() =>
    float a = ta.atr(atrLen)
    bool impulse = close < open and math.abs(close - open) >= a * displacementAtr and
      close < ta.lowest(low[1], bosLookback) and high < low[2]
    int offset = na
    for k = 1 to obLookback
        if na(offset) and close[k] > open[k]
            offset := k
    float candidate = na(offset) ? na : (open[offset] + high[offset]) / 2.0
    ta.valuewhen(impulse and not na(candidate), candidate, 0)[1]

int t15 = request.security(syminfo.tickerid, "15", f_closedTrend(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
int t60 = request.security(syminfo.tickerid, "60", f_closedTrend(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
int t240 = request.security(syminfo.tickerid, "240", f_closedTrend(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
int tD = request.security(syminfo.tickerid, "D", f_closedTrend(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
float bullOb15 = request.security(syminfo.tickerid, "15", f_lastBullOB(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
float bearOb15 = request.security(syminfo.tickerid, "15", f_lastBearOB(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
float bullOb60 = request.security(syminfo.tickerid, "60", f_lastBullOB(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
float bearOb60 = request.security(syminfo.tickerid, "60", f_lastBearOB(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
float bullOb240 = request.security(syminfo.tickerid, "240", f_lastBullOB(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
float bearOb240 = request.security(syminfo.tickerid, "240", f_lastBearOB(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
float bullObD = request.security(syminfo.tickerid, "D", f_lastBullOB(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
float bearObD = request.security(syminfo.tickerid, "D", f_lastBearOB(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)

int longVotes = (t15 == 1 ? 1 : 0) + (t60 == 1 ? 1 : 0) + (t240 == 1 ? 1 : 0) + (tD == 1 ? 1 : 0)
int shortVotes = (t15 == -1 ? 1 : 0) + (t60 == -1 ? 1 : 0) + (t240 == -1 ? 1 : 0) + (tD == -1 ? 1 : 0)
bool longContext = t15 == 1 and t60 == 1 and longVotes >= minTrendVotes
bool shortContext = t15 == -1 and t60 == -1 and shortVotes >= minTrendVotes

float atr = ta.atr(atrLen)
float priorHigh = ta.highest(high[1], bosLookback)
float priorLow = ta.lowest(low[1], bosLookback)
float rangeNow = math.max(high - low, syminfo.mintick)
float body = math.abs(close - open)
bool topClose = (close - low) / rangeNow >= 0.75
bool bottomClose = (high - close) / rangeNow >= 0.75
bool bullFvg = low > high[2] and close > open and body >= atr * displacementAtr and close > priorHigh and topClose
bool bearFvg = high < low[2] and close < open and body >= atr * displacementAtr and close < priorLow and bottomClose

var int pendingDir = 0
var int pendingBar = na
var float plannedEntry = na
var float plannedStop = na
var float plannedTp1 = na
var float plannedTp2 = na
var float activeStop = na
var bool tp1Done = false
var int positionBar = na
var int plannedVotes = 0
var box activeFvgBox = na
var box activeObBox = na
var string lastEvent = "ATTENDRE UN SETUP"

bool positionOpened = strategy.position_size != 0 and strategy.position_size[1] == 0
bool positionClosed = strategy.position_size == 0 and strategy.position_size[1] != 0
if positionOpened
    pendingDir := 0
    pendingBar := na
    plannedEntry := strategy.position_avg_price
    float risk = math.abs(plannedEntry - plannedStop)
    plannedTp1 := plannedEntry + (strategy.position_size > 0 ? 1 : -1) * risk * tp1R
    plannedTp2 := plannedEntry + (strategy.position_size > 0 ? 1 : -1) * risk * tp2R
    activeStop := plannedStop
    tp1Done := false
    positionBar := bar_index
    lastEvent := strategy.position_size > 0 ? "ACHAT LIMITÉ ACTIF" : "VENTE LIMITÉE ACTIVE"

if positionClosed
    pendingDir := 0
    pendingBar := na
    positionBar := na
    plannedEntry := na
    plannedStop := na
    plannedTp1 := na
    plannedTp2 := na
    activeStop := na
    tp1Done := false
    lastEvent := "TRADE FERMÉ · ATTENDRE"
    if not na(activeFvgBox)
        box.delete(activeFvgBox)
        activeFvgBox := na
    if not na(activeObBox)
        box.delete(activeObBox)
        activeObBox := na

if pendingDir != 0 and strategy.position_size == 0
    bool expired = bar_index - pendingBar > orderExpiryBars
    bool lostContext = pendingDir == 1 ? not longContext : not shortContext
    bool invalidated = pendingDir == 1 ? close < plannedStop : close > plannedStop
    if expired or lostContext or invalidated
        strategy.cancel(pendingDir == 1 ? "MDT-L" : "MDT-S")
        pendingDir := 0
        pendingBar := na
        plannedEntry := na
        plannedStop := na
        plannedTp1 := na
        plannedTp2 := na
        lastEvent := expired ? "LIMITE EXPIRÉE" : "SETUP ANNULÉ"
        if not na(activeFvgBox)
            box.delete(activeFvgBox)
            activeFvgBox := na
        if not na(activeObBox)
            box.delete(activeObBox)
            activeObBox := na

bool inMarket = strategy.position_size != 0
if inMarket
    bool longPosition = strategy.position_size > 0
    bool firstTargetTouched = longPosition ? high >= plannedTp1 : low <= plannedTp1
    if not tp1Done and firstTargetTouched
        tp1Done := true
        activeStop := plannedEntry
        lastEvent := "TP1 · 50 % · SL AU BE"
    string entryId = longPosition ? "MDT-L" : "MDT-S"
    string tp1Id = longPosition ? "MDT-L-TP1" : "MDT-S-TP1"
    string tp2Id = longPosition ? "MDT-L-TP2" : "MDT-S-TP2"
    float firstStop = tp1Done ? plannedEntry : plannedStop
    strategy.exit(tp1Id, from_entry=entryId, stop=firstStop, limit=plannedTp1, qty_percent=50, comment_profit="TP1 50%", comment_loss=tp1Done ? "BE" : "SL")
    strategy.exit(tp2Id, from_entry=entryId, stop=activeStop, limit=plannedTp2, qty_percent=50, comment_profit="TP2", comment_loss=tp1Done ? "BE" : "SL")
    if not na(positionBar) and bar_index - positionBar >= maxHoldBars - 1
        strategy.close(entryId, comment="Sortie temps")

bool canArm = barstate.isconfirmed and not inMarket and pendingDir == 0 and (not onlyXau or isXau)
bool longSetup = canArm and bullFvg and longContext
bool shortSetup = canArm and bearFvg and shortContext

if longSetup or shortSetup
    int dir = longSetup ? 1 : -1
    int obOffset = na
    for k = 1 to obLookback
        bool oppositeCandle = dir == 1 ? close[k] < open[k] : close[k] > open[k]
        if na(obOffset) and oppositeCandle
            obOffset := k
    if not na(obOffset) and atr > 0
        float fvgLow = dir == 1 ? high[2] : high
        float fvgHigh = dir == 1 ? low : low[2]
        float obLow = dir == 1 ? low[obOffset] : open[obOffset]
        float obHigh = dir == 1 ? open[obOffset] : high[obOffset]
        float commonLow = math.max(fvgLow, obLow)
        float commonHigh = math.min(fvgHigh, obHigh)
        bool overlap = commonHigh > commonLow
        float entry = overlap ? (commonLow + commonHigh) / 2.0 : (fvgLow + fvgHigh) / 2.0
        float stop = dir == 1 ? math.min(fvgLow, obLow) - math.max(atr * stopAtrBuffer, 2 * syminfo.mintick) :
          math.max(fvgHigh, obHigh) + math.max(atr * stopAtrBuffer, 2 * syminfo.mintick)
        float risk = dir == 1 ? entry - stop : stop - entry
        float estimatedCost = spreadEstimateUsd + 2 * slippageTicks * syminfo.mintick + commissionRoundTrip
        if risk > 0 and risk <= atr * maxStopAtr and estimatedCost / risk <= maxCostR
            pendingDir := dir
            pendingBar := bar_index
            plannedEntry := entry
            plannedStop := stop
            plannedTp1 := entry + dir * risk * tp1R
            plannedTp2 := entry + dir * risk * tp2R
            plannedVotes := dir == 1 ? longVotes : shortVotes
            activeStop := stop
            tp1Done := false
            lastEvent := dir == 1 ? "BUY LIMIT · OB/FVG" : "SELL LIMIT · OB/FVG"
            strategy.entry(dir == 1 ? "MDT-L" : "MDT-S", dir == 1 ? strategy.long : strategy.short,
              qty=orderQty, limit=entry, comment=dir == 1 ? "Buy limit OB/FVG" : "Sell limit OB/FVG")
            if not na(activeFvgBox)
                box.delete(activeFvgBox)
            if not na(activeObBox)
                box.delete(activeObBox)
            if showZones
                activeFvgBox := box.new(bar_index - 2, fvgHigh, bar_index + 1, fvgLow,
                  border_color=dir == 1 ? color.aqua : color.orange,
                  bgcolor=color.new(dir == 1 ? color.aqua : color.orange, 82),
                  extend=extend.right, text=dir == 1 ? "FVG BUY" : "FVG SELL",
                  text_color=color.white, text_size=size.small)
                activeObBox := box.new(bar_index - obOffset, obHigh, bar_index + 1, obLow,
                  border_color=dir == 1 ? color.blue : color.red,
                  bgcolor=color.new(dir == 1 ? color.blue : color.red, 84),
                  extend=extend.right, text=dir == 1 ? "BULL OB" : "BEAR OB",
                  text_color=color.white, text_size=size.small)
            if showLabels
                label.new(bar_index, dir == 1 ? low : high,
                  (dir == 1 ? "BUY LIMIT" : "SELL LIMIT") + "\n" + str.tostring(entry, format.mintick) +
                  "\nConf. " + str.tostring(plannedVotes) + "/4" + (overlap ? " · OB+FVG" : " · FVG"),
                  style=dir == 1 ? label.style_label_up : label.style_label_down,
                  color=dir == 1 ? color.blue : color.red, textcolor=color.white, size=size.small)
            alert((dir == 1 ? "MDT-style BUY LIMIT" : "MDT-style SELL LIMIT") +
              " | " + syminfo.ticker + " | Entry=" + str.tostring(entry, format.mintick) +
              " | SL=" + str.tostring(stop, format.mintick) +
              " | TP1=" + str.tostring(plannedTp1, format.mintick) +
              " | TP2=" + str.tostring(plannedTp2, format.mintick), alert.freq_once_per_bar_close)

f_trendText(int t) => t == 1 ? "Haussier" : t == -1 ? "Baissier" : "Neutre"
f_trendColor(int t) => t == 1 ? color.new(color.green, 15) : t == -1 ? color.new(color.red, 15) : color.new(color.gray, 60)
starText(int n) => n >= 4 ? "★★★★" : n == 3 ? "★★★" : n == 2 ? "★★" : n == 1 ? "★" : "—"

plot(showPlan and (pendingDir != 0 or inMarket) ? plannedEntry : na, "Entrée MDT reconstituée", color=color.blue, linewidth=2, style=plot.style_linebr)
plot(showPlan and (pendingDir != 0 or inMarket) ? (tp1Done ? plannedEntry : plannedStop) : na, "SL actif / BE", color=color.red, linewidth=2, style=plot.style_linebr)
plot(showPlan and (pendingDir != 0 or inMarket) ? plannedTp1 : na, "TP1 · 50 %", color=color.yellow, linewidth=2, style=plot.style_linebr)
plot(showPlan and (pendingDir != 0 or inMarket) ? plannedTp2 : na, "TP2 · reste", color=color.lime, linewidth=2, style=plot.style_linebr)

var table dash = table.new(position.top_right, 6, 9, frame_color=color.new(color.silver, 25), frame_width=1, border_color=color.new(color.silver, 65), border_width=1)
if barstate.islast
    table.cell(dash, 0, 0, "TF", bgcolor=color.black, text_color=color.white, text_size=size.tiny)
    table.cell(dash, 1, 0, "TREND", bgcolor=color.black, text_color=color.white, text_size=size.tiny)
    table.cell(dash, 2, 0, "BULL OB", bgcolor=color.black, text_color=color.white, text_size=size.tiny)
    table.cell(dash, 3, 0, "CONF", bgcolor=color.black, text_color=color.white, text_size=size.tiny)
    table.cell(dash, 4, 0, "BEAR OB", bgcolor=color.black, text_color=color.white, text_size=size.tiny)
    table.cell(dash, 5, 0, "CONF", bgcolor=color.black, text_color=color.white, text_size=size.tiny)
    table.cell(dash, 0, 1, "15", text_color=color.white, text_size=size.tiny)
    table.cell(dash, 1, 1, f_trendText(t15), bgcolor=f_trendColor(t15), text_color=color.white, text_size=size.tiny)
    table.cell(dash, 2, 1, na(bullOb15) ? "—" : str.tostring(bullOb15, format.mintick), text_color=color.aqua, text_size=size.tiny)
    table.cell(dash, 3, 1, starText(na(bullOb15) ? 0 : longVotes), text_color=color.yellow, text_size=size.tiny)
    table.cell(dash, 4, 1, na(bearOb15) ? "—" : str.tostring(bearOb15, format.mintick), text_color=color.orange, text_size=size.tiny)
    table.cell(dash, 5, 1, starText(na(bearOb15) ? 0 : shortVotes), text_color=color.yellow, text_size=size.tiny)
    table.cell(dash, 0, 2, "60", text_color=color.white, text_size=size.tiny)
    table.cell(dash, 1, 2, f_trendText(t60), bgcolor=f_trendColor(t60), text_color=color.white, text_size=size.tiny)
    table.cell(dash, 2, 2, na(bullOb60) ? "—" : str.tostring(bullOb60, format.mintick), text_color=color.aqua, text_size=size.tiny)
    table.cell(dash, 3, 2, starText(na(bullOb60) ? 0 : longVotes), text_color=color.yellow, text_size=size.tiny)
    table.cell(dash, 4, 2, na(bearOb60) ? "—" : str.tostring(bearOb60, format.mintick), text_color=color.orange, text_size=size.tiny)
    table.cell(dash, 5, 2, starText(na(bearOb60) ? 0 : shortVotes), text_color=color.yellow, text_size=size.tiny)
    table.cell(dash, 0, 3, "240", text_color=color.white, text_size=size.tiny)
    table.cell(dash, 1, 3, f_trendText(t240), bgcolor=f_trendColor(t240), text_color=color.white, text_size=size.tiny)
    table.cell(dash, 2, 3, na(bullOb240) ? "—" : str.tostring(bullOb240, format.mintick), text_color=color.aqua, text_size=size.tiny)
    table.cell(dash, 3, 3, starText(na(bullOb240) ? 0 : longVotes), text_color=color.yellow, text_size=size.tiny)
    table.cell(dash, 4, 3, na(bearOb240) ? "—" : str.tostring(bearOb240, format.mintick), text_color=color.orange, text_size=size.tiny)
    table.cell(dash, 5, 3, starText(na(bearOb240) ? 0 : shortVotes), text_color=color.yellow, text_size=size.tiny)
    table.cell(dash, 0, 4, "D", text_color=color.white, text_size=size.tiny)
    table.cell(dash, 1, 4, f_trendText(tD), bgcolor=f_trendColor(tD), text_color=color.white, text_size=size.tiny)
    table.cell(dash, 2, 4, na(bullObD) ? "—" : str.tostring(bullObD, format.mintick), text_color=color.aqua, text_size=size.tiny)
    table.cell(dash, 3, 4, starText(na(bullObD) ? 0 : longVotes), text_color=color.yellow, text_size=size.tiny)
    table.cell(dash, 4, 4, na(bearObD) ? "—" : str.tostring(bearObD, format.mintick), text_color=color.orange, text_size=size.tiny)
    table.cell(dash, 5, 4, starText(na(bearObD) ? 0 : shortVotes), text_color=color.yellow, text_size=size.tiny)
    table.cell(dash, 0, 5, "SETUP", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 5, lastEvent, bgcolor=pendingDir != 0 ? color.new(color.blue, 35) : inMarket ? color.new(color.teal, 35) : color.new(color.gray, 65), text_color=color.white, text_size=size.tiny)
    table.cell(dash, 2, 5, "VOTES", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 3, 5, str.tostring(pendingDir == 1 ? longVotes : pendingDir == -1 ? shortVotes : inMarket ? plannedVotes : 0) + "/4", text_color=color.yellow, text_size=size.tiny)
    table.cell(dash, 4, 5, "TYPE", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 5, 5, "LIMITE", text_color=color.aqua, text_size=size.tiny)
    table.cell(dash, 0, 6, "ENTRY", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 6, not na(plannedEntry) ? str.tostring(plannedEntry, format.mintick) : "—", text_color=color.aqua, text_size=size.tiny)
    table.cell(dash, 2, 6, "SL/BE", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 3, 6, not na(plannedStop) ? str.tostring(tp1Done ? plannedEntry : plannedStop, format.mintick) : "—", text_color=color.red, text_size=size.tiny)
    table.cell(dash, 4, 6, "TP1/50%", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 5, 6, not na(plannedTp1) ? str.tostring(plannedTp1, format.mintick) : "—", text_color=color.yellow, text_size=size.tiny)
    table.cell(dash, 0, 7, "TP2", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 7, not na(plannedTp2) ? str.tostring(plannedTp2, format.mintick) : "—", text_color=color.lime, text_size=size.tiny)
    table.cell(dash, 2, 7, "R1/R2", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 3, 7, str.tostring(tp1R, "#.00") + "/" + str.tostring(tp2R, "#.0"), text_color=color.lime, text_size=size.tiny)
    table.cell(dash, 4, 7, "SORTIE", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 5, 7, str.tostring(maxHoldBars * 5) + " min", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 0, 8, "NOTE", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 8, "Proxy", text_color=color.orange, text_size=size.tiny)
    table.cell(dash, 2, 8, "Conf. ≠ proba", text_color=color.orange, text_size=size.tiny)
    table.cell(dash, 3, 8, "Spread=" + str.tostring(spreadEstimateUsd, "#.00"), text_color=color.orange, text_size=size.tiny)
    table.cell(dash, 4, 8, "Commission=" + str.tostring(commissionRoundTrip, "#.00"), text_color=color.orange, text_size=size.tiny)
    table.cell(dash, 5, 8, "M5", text_color=color.silver, text_size=size.tiny)
