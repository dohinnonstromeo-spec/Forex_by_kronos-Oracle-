//@version=6
strategy("KRONOS XAUUSD - Sweep + FVG Retest R3 Research", shorttitle="KRONOS XAU R3", overlay=true,
     pyramiding=0, initial_capital=1000, currency=currency.USD, default_qty_type=strategy.fixed,
     default_qty_value=1, commission_type=strategy.commission.cash_per_contract, commission_value=0,
     slippage=1, process_orders_on_close=false, use_bar_magnifier=true,
     max_labels_count=200, max_boxes_count=100, max_lines_count=50)

// Research branch inspired by visible MDT concepts; not the private MDT source code.
// The KRONOS trigger is kept: M5 sweep -> displacement/BOS + FVG -> confirmed midpoint retest.
// The OB box is a visual proxy only; it does not trigger entries in this tested branch.
// Defaults match the 30-minute R2 research reference because new filter/exit variants are not proven superior.

string TZ = "Etc/UTC"
string G_LEVELS = "01 - Liquidity / session"
string G_SIGNAL = "02 - KRONOS PA trigger"
string G_MTF = "03 - MTF research filter"
string G_RISK = "04 - Exits and costs"
string G_VIEW = "05 - Phone display"

int sweepLookback = input.int(20, "Sweep window (M5 bars)", minval=5, maxval=100, group=G_LEVELS)
int sweepWaitBars = input.int(5, "Bars allowed: sweep to displacement", minval=1, maxval=20, group=G_LEVELS)
string tradeSession = input.session("0700-1700:23456", "Entry window UTC", group=G_LEVELS)
bool useSession = input.bool(true, "Limit entries to session", group=G_LEVELS)

int atrLength = input.int(14, "ATR M5", minval=2, maxval=100, group=G_SIGNAL)
int bosLookback = input.int(5, "BOS lookback (M5)", minval=2, maxval=20, group=G_SIGNAL)
float displacementAtr = input.float(0.60, "Displacement body (x ATR)", minval=0.1, maxval=3, step=0.05, group=G_SIGNAL)
int fvgRetestBars = input.int(12, "FVG retest expiry (M5 bars)", minval=1, maxval=48, group=G_SIGNAL)
int obLookback = input.int(5, "OB proxy search (bars before displacement)", minval=1, maxval=15, group=G_SIGNAL)

bool useMtfFilter = input.bool(false, "Require MTF votes (research)", group=G_MTF,
     tooltip="Off by default: the Deriv sample is too small to establish an improvement.")
int minMtfVotes = input.int(2, "Minimum aligned frames / 4", minval=1, maxval=4, group=G_MTF)
bool requireM15H1 = input.bool(false, "Also require M15 and H1 to agree", group=G_MTF)

float tp1R = input.float(1.0, "TP1 in R - close 50%", minval=0.2, maxval=5, step=0.1, group=G_RISK)
float tp2R = input.float(1.5, "TP2 in R - close remainder", minval=0.3, maxval=8, step=0.1, group=G_RISK)
bool moveStopToBE = input.bool(false, "Move remaining stop to breakeven after TP1", group=G_RISK)
int maxHoldBars = input.int(6, "Maximum position time (M5 bars)", minval=1, maxval=100, group=G_RISK)
float spreadEstimateUsd = input.float(0.15, "Estimated XAUUSD spread ($)", minval=0, maxval=10, step=0.01, group=G_RISK)
int slippageTicks = input.int(1, "Slippage estimate (ticks per side)", minval=0, maxval=100, group=G_RISK)
float roundTripCommissionUsd = input.float(0, "Round-trip commission ($)", minval=0, maxval=100, step=0.01, group=G_RISK)
float maxCostR = input.float(0.15, "Maximum estimated cost / R", minval=0, maxval=1, step=0.01, group=G_RISK)
float stopAtrBuffer = input.float(0.10, "Stop buffer behind sweep (x ATR)", minval=0.01, maxval=1, step=0.01, group=G_RISK)
float maxStopAtr = input.float(3.0, "Maximum stop distance (x ATR)", minval=0.5, maxval=10, step=0.25, group=G_RISK)
float simulatedQty = input.float(1.0, "Strategy Tester quantity", minval=0.001, step=0.01, group=G_RISK)

bool showLiquidity = input.bool(true, "Show recent liquidity levels", group=G_VIEW)
bool showFvg = input.bool(true, "Show active FVG", group=G_VIEW)
bool showOb = input.bool(true, "Show last-opposite-candle OB proxy", group=G_VIEW)
bool showOrders = input.bool(true, "Show Entry / SL / TP1 / TP2", group=G_VIEW)
bool showSignals = input.bool(true, "Show setup stages", group=G_VIEW)
string panelMode = input.string("Mobile", "Panel detail", options=["Mobile", "Detailed"], group=G_VIEW)

bool isM5 = timeframe.isminutes and timeframe.multiplier == 5
if barstate.isfirst and not isM5
    runtime.error("KRONOS XAU R3 Research runs on a 5-minute chart (M5).")
if barstate.isfirst and tp2R <= tp1R
    runtime.error("TP2 must be greater than TP1.")

bool isXau = str.contains(str.upper(syminfo.ticker), "XAU")
float atr = ta.atr(atrLength)
float priorHigh = ta.highest(high[1], sweepLookback)
float priorLow = ta.lowest(low[1], sweepLookback)
float swingHigh = ta.highest(high[1], bosLookback)
float swingLow = ta.lowest(low[1], bosLookback)
float candleRange = math.max(high - low, syminfo.mintick)
float candleBody = math.abs(close - open)

// Confirmed higher-timeframe data only. The [1] offset plus lookahead_on avoids using a developing HTF bar.
[m15Close, m15Ema20, m15Ema50, m15Ema20TwoBarsAgo] = request.security(syminfo.tickerid, "15",
     [close[1], ta.ema(close, 20)[1], ta.ema(close, 50)[1], ta.ema(close, 20)[3]], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
[h1Close, h1Ema20, h1Ema50, h1Ema20TwoBarsAgo] = request.security(syminfo.tickerid, "60",
     [close[1], ta.ema(close, 20)[1], ta.ema(close, 50)[1], ta.ema(close, 20)[3]], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
[h4Close, h4Ema20, h4Ema50, h4Ema20TwoBarsAgo] = request.security(syminfo.tickerid, "240",
     [close[1], ta.ema(close, 20)[1], ta.ema(close, 50)[1], ta.ema(close, 20)[3]], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
[dClose, dEma20, dEma50, dEma20TwoBarsAgo] = request.security(syminfo.tickerid, "D",
     [close[1], ta.ema(close, 20)[1], ta.ema(close, 50)[1], ta.ema(close, 20)[3]], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)

bool m15Bull = m15Close > m15Ema20 and m15Ema20 > m15Ema50 and m15Ema20 > m15Ema20TwoBarsAgo
bool m15Bear = m15Close < m15Ema20 and m15Ema20 < m15Ema50 and m15Ema20 < m15Ema20TwoBarsAgo
bool h1Bull = h1Close > h1Ema20 and h1Ema20 > h1Ema50 and h1Ema20 > h1Ema20TwoBarsAgo
bool h1Bear = h1Close < h1Ema20 and h1Ema20 < h1Ema50 and h1Ema20 < h1Ema20TwoBarsAgo
bool h4Bull = h4Close > h4Ema20 and h4Ema20 > h4Ema50 and h4Ema20 > h4Ema20TwoBarsAgo
bool h4Bear = h4Close < h4Ema20 and h4Ema20 < h4Ema50 and h4Ema20 < h4Ema20TwoBarsAgo
bool dBull = dClose > dEma20 and dEma20 > dEma50 and dEma20 > dEma20TwoBarsAgo
bool dBear = dClose < dEma20 and dEma20 < dEma50 and dEma20 < dEma20TwoBarsAgo
int bullVotes = (m15Bull ? 1 : 0) + (h1Bull ? 1 : 0) + (h4Bull ? 1 : 0) + (dBull ? 1 : 0)
int bearVotes = (m15Bear ? 1 : 0) + (h1Bear ? 1 : 0) + (h4Bear ? 1 : 0) + (dBear ? 1 : 0)
bool mtfAllowsLong = not useMtfFilter or (bullVotes >= minMtfVotes and (not requireM15H1 or (m15Bull and h1Bull)))
bool mtfAllowsShort = not useMtfFilter or (bearVotes >= minMtfVotes and (not requireM15H1 or (m15Bear and h1Bear)))
bool inTradeHours = not useSession or not na(time(timeframe.period, tradeSession, TZ))

var int sweepDirection = 0
var int sweepBar = na
var float sweepExtreme = na
var float sweptLevel = na
var int fvgDirection = 0
var int fvgBar = na
var float fvgLower = na
var float fvgUpper = na
var float fvgMid = na
var float obLower = na
var float obUpper = na
var float plannedStop = na
var float plannedEntry = na
var float plannedTp1 = na
var float plannedTp2 = na
var int positionEntryBar = na
var int pendingDirection = 0
var float entrySizeAtFill = na
var bool beActivated = false
var box activeFvgBox = na
var box activeObBox = na
var string lastEvent = "WAIT FOR SETUP"

bool bullSweep = barstate.isconfirmed and inTradeHours and not na(priorLow) and low < priorLow and close > priorLow
bool bearSweep = barstate.isconfirmed and inTradeHours and not na(priorHigh) and high > priorHigh and close < priorHigh

if barstate.isconfirmed
    if sweepDirection != 0 and (bar_index - sweepBar > sweepWaitBars or (sweepDirection == 1 and low <= sweepExtreme) or (sweepDirection == -1 and high >= sweepExtreme))
        sweepDirection := 0
        sweepBar := na
        sweepExtreme := na
        sweptLevel := na
    if fvgDirection != 0 and (bar_index - fvgBar > fvgRetestBars or (fvgDirection == 1 and low <= plannedStop) or (fvgDirection == -1 and high >= plannedStop))
        fvgDirection := 0
        fvgBar := na
        fvgLower := na
        fvgUpper := na
        fvgMid := na
        plannedStop := na
        obLower := na
        obUpper := na
        if not na(activeFvgBox)
            box.delete(activeFvgBox)
            activeFvgBox := na
        if not na(activeObBox)
            box.delete(activeObBox)
            activeObBox := na
        lastEvent := "FVG / OB EXPIRED"

    bool bullDisplacement = close > open and candleBody >= atr * displacementAtr and close > swingHigh and low > high[2] and close >= low + candleRange * 0.75
    bool bearDisplacement = close < open and candleBody >= atr * displacementAtr and close < swingLow and high < low[2] and close <= high - candleRange * 0.75

    if fvgDirection == 0 and sweepDirection == 1 and bar_index > sweepBar and bullDisplacement
        fvgDirection := 1
        fvgBar := bar_index
        fvgLower := high[2]
        fvgUpper := low
        fvgMid := (fvgLower + fvgUpper) / 2.0
        plannedStop := sweepExtreme - math.max(atr * stopAtrBuffer, 2 * syminfo.mintick)
        obLower := na
        obUpper := na
        for offset = 1 to obLookback
            if na(obLower) and close[offset] < open[offset]
                obLower := low[offset]
                obUpper := high[offset]
        sweepDirection := 0
        sweepBar := na
        lastEvent := "BULLISH BOS + FVG"
        if not na(activeFvgBox)
            box.delete(activeFvgBox)
        if not na(activeObBox)
            box.delete(activeObBox)
        if showFvg
            activeFvgBox := box.new(bar_index - 2, fvgUpper, bar_index + 1, fvgLower, border_color=color.lime, bgcolor=color.new(color.lime, 84), extend=extend.right, text="FVG LONG", text_color=color.lime, text_size=size.small)
        if showOb and not na(obLower)
            activeObBox := box.new(bar_index - 1, obUpper, bar_index + 1, obLower, border_color=color.teal, bgcolor=color.new(color.teal, 82), extend=extend.right, text="OB proxy", text_color=color.teal, text_size=size.small)
        if showSignals
            label.new(bar_index, low, "BOS + FVG\nwait for retest", style=label.style_label_up, color=color.green, textcolor=color.white, size=size.small)
        alert("KRONOS XAU R3 | bullish displacement + FVG | wait for retest | " + syminfo.ticker, alert.freq_once_per_bar_close)
    else if fvgDirection == 0 and sweepDirection == -1 and bar_index > sweepBar and bearDisplacement
        fvgDirection := -1
        fvgBar := bar_index
        fvgLower := high
        fvgUpper := low[2]
        fvgMid := (fvgLower + fvgUpper) / 2.0
        plannedStop := sweepExtreme + math.max(atr * stopAtrBuffer, 2 * syminfo.mintick)
        obLower := na
        obUpper := na
        for offset = 1 to obLookback
            if na(obLower) and close[offset] > open[offset]
                obLower := low[offset]
                obUpper := high[offset]
        sweepDirection := 0
        sweepBar := na
        lastEvent := "BEARISH BOS + FVG"
        if not na(activeFvgBox)
            box.delete(activeFvgBox)
        if not na(activeObBox)
            box.delete(activeObBox)
        if showFvg
            activeFvgBox := box.new(bar_index - 2, fvgUpper, bar_index + 1, fvgLower, border_color=color.red, bgcolor=color.new(color.red, 84), extend=extend.right, text="FVG SHORT", text_color=color.red, text_size=size.small)
        if showOb and not na(obLower)
            activeObBox := box.new(bar_index - 1, obUpper, bar_index + 1, obLower, border_color=color.orange, bgcolor=color.new(color.orange, 82), extend=extend.right, text="OB proxy", text_color=color.orange, text_size=size.small)
        if showSignals
            label.new(bar_index, high, "BOS + FVG\nwait for retest", style=label.style_label_down, color=color.red, textcolor=color.white, size=size.small)
        alert("KRONOS XAU R3 | bearish displacement + FVG | wait for retest | " + syminfo.ticker, alert.freq_once_per_bar_close)

bool longSignal = false
bool shortSignal = false
float estimatedCost = spreadEstimateUsd + 2.0 * slippageTicks * syminfo.mintick + roundTripCommissionUsd
if barstate.isconfirmed and fvgDirection != 0 and bar_index > fvgBar and inTradeHours and strategy.position_size == 0
    bool midpointTouched = low <= fvgMid and high >= fvgMid
    bool bullRetest = fvgDirection == 1 and midpointTouched and close > fvgMid and close > open
    bool bearRetest = fvgDirection == -1 and midpointTouched and close < fvgMid and close < open
    float longRisk = close - plannedStop
    float shortRisk = plannedStop - close
    bool longRiskOk = longRisk > 0 and longRisk <= atr * maxStopAtr and estimatedCost / longRisk <= maxCostR
    bool shortRiskOk = shortRisk > 0 and shortRisk <= atr * maxStopAtr and estimatedCost / shortRisk <= maxCostR
    longSignal := bullRetest and longRiskOk and mtfAllowsLong and isXau
    shortSignal := bearRetest and shortRiskOk and mtfAllowsShort and isXau
    if longSignal
        pendingDirection := 1
        plannedEntry := close
        plannedTp1 := plannedEntry + longRisk * tp1R
        plannedTp2 := plannedEntry + longRisk * tp2R
        beActivated := false
        entrySizeAtFill := na
        strategy.entry("K-XAU-L", strategy.long, qty=simulatedQty, comment="Sweep/BOS/FVG retest")
        strategy.exit("K-XAU-L-TP1", from_entry="K-XAU-L", stop=plannedStop, limit=plannedTp1, qty_percent=50)
        strategy.exit("K-XAU-L-TP2", from_entry="K-XAU-L", stop=plannedStop, limit=plannedTp2, qty_percent=50)
        lastEvent := "LONG - FVG retest confirmed"
        fvgDirection := 0
        fvgBar := na
        if not na(activeFvgBox)
            box.delete(activeFvgBox)
            activeFvgBox := na
        if not na(activeObBox)
            box.delete(activeObBox)
            activeObBox := na
        alert("KRONOS XAU R3 | BUY | entry~" + str.tostring(plannedEntry, format.mintick) + " | SL=" + str.tostring(plannedStop, format.mintick) + " | TP1=" + str.tostring(plannedTp1, format.mintick) + " | TP2=" + str.tostring(plannedTp2, format.mintick), alert.freq_once_per_bar_close)
    else if shortSignal
        pendingDirection := -1
        plannedEntry := close
        plannedTp1 := plannedEntry - shortRisk * tp1R
        plannedTp2 := plannedEntry - shortRisk * tp2R
        beActivated := false
        entrySizeAtFill := na
        strategy.entry("K-XAU-S", strategy.short, qty=simulatedQty, comment="Sweep/BOS/FVG retest")
        strategy.exit("K-XAU-S-TP1", from_entry="K-XAU-S", stop=plannedStop, limit=plannedTp1, qty_percent=50)
        strategy.exit("K-XAU-S-TP2", from_entry="K-XAU-S", stop=plannedStop, limit=plannedTp2, qty_percent=50)
        lastEvent := "SHORT - FVG retest confirmed"
        fvgDirection := 0
        fvgBar := na
        if not na(activeFvgBox)
            box.delete(activeFvgBox)
            activeFvgBox := na
        if not na(activeObBox)
            box.delete(activeObBox)
            activeObBox := na
        alert("KRONOS XAU R3 | SELL | entry~" + str.tostring(plannedEntry, format.mintick) + " | SL=" + str.tostring(plannedStop, format.mintick) + " | TP1=" + str.tostring(plannedTp1, format.mintick) + " | TP2=" + str.tostring(plannedTp2, format.mintick), alert.freq_once_per_bar_close)

if strategy.position_size != 0 and strategy.position_size[1] == 0
    positionEntryBar := bar_index
    pendingDirection := 0
    plannedEntry := strategy.position_avg_price
    entrySizeAtFill := math.abs(strategy.position_size)
    beActivated := false
    float filledRisk = math.abs(plannedEntry - plannedStop)
    if strategy.position_size > 0 and filledRisk > 0
        plannedTp1 := plannedEntry + filledRisk * tp1R
        plannedTp2 := plannedEntry + filledRisk * tp2R
    else if strategy.position_size < 0 and filledRisk > 0
        plannedTp1 := plannedEntry - filledRisk * tp1R
        plannedTp2 := plannedEntry - filledRisk * tp2R

if strategy.position_size != 0 and not na(entrySizeAtFill) and math.abs(strategy.position_size) < entrySizeAtFill * 0.75
    beActivated := true

float liveStop = moveStopToBE and beActivated ? plannedEntry : plannedStop
if strategy.position_size > 0 and not na(liveStop) and not na(plannedTp1) and not na(plannedTp2)
    strategy.exit("K-XAU-L-TP1", from_entry="K-XAU-L", stop=liveStop, limit=plannedTp1, qty_percent=50)
    strategy.exit("K-XAU-L-TP2", from_entry="K-XAU-L", stop=liveStop, limit=plannedTp2, qty_percent=50)
else if strategy.position_size < 0 and not na(liveStop) and not na(plannedTp1) and not na(plannedTp2)
    strategy.exit("K-XAU-S-TP1", from_entry="K-XAU-S", stop=liveStop, limit=plannedTp1, qty_percent=50)
    strategy.exit("K-XAU-S-TP2", from_entry="K-XAU-S", stop=liveStop, limit=plannedTp2, qty_percent=50)

if strategy.position_size == 0 and strategy.position_size[1] != 0
    positionEntryBar := na
    pendingDirection := 0
    plannedEntry := na
    plannedTp1 := na
    plannedTp2 := na
    plannedStop := na
    entrySizeAtFill := na
    beActivated := false
    lastEvent := "TRADE CLOSED - wait for new sweep"

if strategy.position_size != 0 and not na(positionEntryBar) and bar_index - positionEntryBar >= maxHoldBars - 1
    if strategy.position_size > 0
        strategy.close("K-XAU-L", comment="Time exit")
    else
        strategy.close("K-XAU-S", comment="Time exit")

if barstate.isconfirmed and strategy.position_size == 0 and fvgDirection == 0 and sweepDirection == 0 and not longSignal and not shortSignal and inTradeHours and isXau
    if bullSweep
        sweepDirection := 1
        sweepBar := bar_index
        sweepExtreme := low
        sweptLevel := priorLow
        lastEvent := "LOW SWEEP - wait BOS + FVG"
        if showSignals
            label.new(bar_index, low, "SWEEP LOW\nwait displacement", style=label.style_label_up, color=color.teal, textcolor=color.white, size=size.small)
        alert("KRONOS XAU R3 | low sweep confirmed | wait displacement + FVG | " + syminfo.ticker, alert.freq_once_per_bar_close)
    else if bearSweep
        sweepDirection := -1
        sweepBar := bar_index
        sweepExtreme := high
        sweptLevel := priorHigh
        lastEvent := "HIGH SWEEP - wait BOS + FVG"
        if showSignals
            label.new(bar_index, high, "SWEEP HIGH\nwait displacement", style=label.style_label_down, color=color.orange, textcolor=color.white, size=size.small)
        alert("KRONOS XAU R3 | high sweep confirmed | wait displacement + FVG | " + syminfo.ticker, alert.freq_once_per_bar_close)

if fvgDirection != 0 and not na(activeFvgBox)
    box.set_right(activeFvgBox, bar_index + 1)
if fvgDirection != 0 and not na(activeObBox)
    box.set_right(activeObBox, bar_index + 1)

float displayEntry = strategy.position_size != 0 or pendingDirection != 0 ? plannedEntry : na
float displayStop = strategy.position_size != 0 or pendingDirection != 0 ? liveStop : na
float displayTp1 = strategy.position_size != 0 or pendingDirection != 0 ? plannedTp1 : na
float displayTp2 = strategy.position_size != 0 or pendingDirection != 0 ? plannedTp2 : na
plot(showLiquidity ? priorHigh : na, "Recent liquidity - high", color=color.new(color.red, 35), linewidth=1, style=plot.style_linebr)
plot(showLiquidity ? priorLow : na, "Recent liquidity - low", color=color.new(color.aqua, 35), linewidth=1, style=plot.style_linebr)
plot(showLiquidity and sweepDirection != 0 ? sweptLevel : na, "Swept level", color=color.yellow, linewidth=2, style=plot.style_linebr)
plot(showOrders ? displayEntry : na, "Entry", color=color.blue, linewidth=2, style=plot.style_linebr)
plot(showOrders ? displayStop : na, "SL / BE", color=color.red, linewidth=2, style=plot.style_linebr)
plot(showOrders ? displayTp1 : na, "TP1 - 50%", color=color.new(color.lime, 25), linewidth=1, style=plot.style_linebr)
plot(showOrders ? displayTp2 : na, "TP2 - remainder", color=color.lime, linewidth=2, style=plot.style_linebr)
plotshape(showSignals and longSignal, title="Long after FVG retest", style=shape.labelup, location=location.belowbar, color=color.lime, text="LONG\nFVG", textcolor=color.black, size=size.small)
plotshape(showSignals and shortSignal, title="Short after FVG retest", style=shape.labeldown, location=location.abovebar, color=color.red, text="SHORT\nFVG", textcolor=color.white, size=size.small)

float historicalPositivePct = strategy.closedtrades > 0 ? 100.0 * strategy.wintrades / strategy.closedtrades : na
string positiveText = na(historicalPositivePct) ? "N/A" : str.tostring(historicalPositivePct, "#.0") + "% exits positive"
string scenarioText = strategy.position_size > 0 ? "LONG ACTIVE" : strategy.position_size < 0 ? "SHORT ACTIVE" : pendingDirection == 1 ? "LONG ORDER" : pendingDirection == -1 ? "SHORT ORDER" : fvgDirection == 1 ? "WAIT LONG FVG RETEST" : fvgDirection == -1 ? "WAIT SHORT FVG RETEST" : sweepDirection == 1 ? "WATCH LONG BOS + FVG" : sweepDirection == -1 ? "WATCH SHORT BOS + FVG" : "WAIT FOR SWEEP"
string logicText = strategy.position_size != 0 ? (beActivated ? "TP1 reached; stop at entry." : "Trade active; stop beyond sweep.") : pendingDirection != 0 ? "Order simulated; SL and targets shown." : fvgDirection != 0 ? "BOS+FVG valid; wait midpoint retest." : sweepDirection != 0 ? "Sweep confirmed; wait displacement." : "No setup; wait for sweep."
string mtfText = "15:" + (m15Bull ? "+" : m15Bear ? "-" : "0") + " H1:" + (h1Bull ? "+" : h1Bear ? "-" : "0") + " H4:" + (h4Bull ? "+" : h4Bear ? "-" : "0") + " D:" + (dBull ? "+" : dBear ? "-" : "0")
string mtfScore = "Long " + str.tostring(bullVotes) + "/4 | Short " + str.tostring(bearVotes) + "/4"
string entryText = not na(displayEntry) ? str.tostring(displayEntry, format.mintick) : "After confirmed retest"
string stopText = not na(displayStop) ? str.tostring(displayStop, format.mintick) : not na(plannedStop) ? str.tostring(plannedStop, format.mintick) : "Beyond sweep"
string tp1Text = not na(displayTp1) ? str.tostring(displayTp1, format.mintick) : "After entry"
string tp2Text = not na(displayTp2) ? str.tostring(displayTp2, format.mintick) : "After entry"
color statusColor = strategy.position_size != 0 ? color.new(color.blue, 20) : fvgDirection != 0 ? color.new(color.green, 30) : sweepDirection != 0 ? color.new(color.orange, 25) : color.new(color.gray, 55)

var table panel = table.new(position.top_right, 2, 12, frame_color=color.new(color.silver, 35), frame_width=1, border_color=color.new(color.silver, 70), border_width=1)
if barstate.islast
    table.cell(panel, 0, 0, "KRONOS XAU R3", bgcolor=color.black, text_color=color.white)
    table.cell(panel, 1, 0, isXau ? syminfo.ticker + " - M5" : "NON-XAU CHART", bgcolor=color.black, text_color=isXau ? color.white : color.orange)
    table.cell(panel, 0, 1, "SCENARIO", text_color=color.white)
    table.cell(panel, 1, 1, scenarioText, bgcolor=statusColor, text_color=color.white)
    table.cell(panel, 0, 2, "MTF 15/60/240/D", text_color=color.silver)
    table.cell(panel, 1, 2, mtfText, text_color=color.white)
    table.cell(panel, 0, 3, "MTF VOTES", text_color=color.silver)
    table.cell(panel, 1, 3, mtfScore, text_color=color.aqua)
    table.cell(panel, 0, 4, "ENTRY", text_color=color.silver)
    table.cell(panel, 1, 4, entryText, text_color=color.blue)
    table.cell(panel, 0, 5, "SL / BE", text_color=color.silver)
    table.cell(panel, 1, 5, stopText, text_color=color.red)
    table.cell(panel, 0, 6, "TP1 - 50%", text_color=color.silver)
    table.cell(panel, 1, 6, tp1Text + " - " + str.tostring(tp1R, "#.##") + "R", text_color=color.lime)
    table.cell(panel, 0, 7, "TP2 - rest", text_color=color.silver)
    table.cell(panel, 1, 7, tp2Text + " - " + str.tostring(tp2R, "#.##") + "R", text_color=color.lime)
    table.cell(panel, 0, 8, "LOGIC", text_color=color.silver)
    table.cell(panel, 1, 8, panelMode == "Mobile" ? logicText : logicText + " | " + lastEvent, text_color=color.white)
    table.cell(panel, 0, 9, "FILTER", text_color=color.silver)
    table.cell(panel, 1, 9, useMtfFilter ? "ON - " + str.tostring(minMtfVotes) + "/4" : "OFF (R2 reference)", text_color=useMtfFilter ? color.orange : color.aqua)
    table.cell(panel, 0, 10, "HISTORICAL", text_color=color.silver)
    table.cell(panel, 1, 10, positiveText, text_color=na(historicalPositivePct) ? color.orange : color.aqua)
    table.cell(panel, 0, 11, "NOTE", text_color=color.silver)
    table.cell(panel, 1, 11, "Research only; no profit guarantee.", text_color=color.orange)
