//@version=6
strategy("KRONOS XAUUSD — Sweep + Displacement + FVG Retest R1",
     shorttitle="KRONOS XAU R1", overlay=true, pyramiding=0,
     initial_capital=1000, currency=currency.USD,
     default_qty_type=strategy.fixed, default_qty_value=1,
     commission_type=strategy.commission.cash_per_contract, commission_value=0,
     slippage=1, process_orders_on_close=false,
     max_labels_count=200, max_boxes_count=50, max_lines_count=50)

// Recherche XAUUSD dédiée. Signaux prévus pour un graphique M5.
// Le script affiche les étapes du scénario et place des ordres Strategy Tester.
// Il ne garantit pas une rentabilité et n'automatise pas une connexion à Deriv.

string TZ = "Etc/UTC"
string G_LEVELS = "01 · Niveaux de liquidité"
string G_CONFIRM = "02 · Confirmation PA / FVG"
string G_COSTS = "03 · Coûts et risque"
string G_VIEW = "04 · Affichage téléphone"

int sweepLookback = input.int(20, "Fenêtre du haut/bas à balayer (M5)", minval=5, maxval=100, group=G_LEVELS)
int sweepWaitBars = input.int(5, "Délai sweep → displacement (bougies M5)", minval=1, maxval=20, group=G_LEVELS)
string tradeSession = input.session("0700-1700:23456", "Fenêtre d'entrée UTC", group=G_LEVELS)
bool useSession = input.bool(true, "Limiter à la fenêtre UTC", group=G_LEVELS)

int atrLength = input.int(14, "ATR M5", minval=2, maxval=100, group=G_CONFIRM)
int bosLookback = input.int(5, "Cassure structurelle (M5)", minval=2, maxval=20, group=G_CONFIRM)
float displacementAtr = input.float(0.60, "Corps displacement minimum (x ATR)", minval=0.1, maxval=3.0, step=0.05, group=G_CONFIRM)
int fvgRetestBars = input.int(12, "Expiration du retest FVG (bougies M5)", minval=1, maxval=48, group=G_CONFIRM)
bool useM15Filter = input.bool(false, "Exiger l'alignement M15", group=G_CONFIRM,
     tooltip="Désactivé par défaut, comme la variante évaluée sur les données Deriv. L'activer crée une variante différente qui doit être retestée.")
float targetR = input.float(1.50, "Objectif (R)", minval=0.5, maxval=5.0, step=0.1, group=G_CONFIRM)
int maxHoldBars = input.int(12, "Durée maximale (bougies M5)", minval=1, maxval=100, group=G_CONFIRM)

float spreadEstimateUsd = input.float(0.15, "Spread estimé XAUUSD ($)", minval=0.0, maxval=10.0, step=0.01, group=G_COSTS,
     tooltip="Valeur médiane/p75 observée dans l'historique Deriv-Demo utilisé pour la recherche. Vérifie le spread de ton compte.")
int slippageTicks = input.int(1, "Slippage estimé (ticks par côté)", minval=0, maxval=100, group=G_COSTS)
float roundTripCommissionUsd = input.float(0.0, "Commission totale estimée ($)", minval=0.0, maxval=100.0, step=0.01, group=G_COSTS)
float maxCostR = input.float(0.15, "Coût estimé maximal (R)", minval=0.0, maxval=1.0, step=0.01, group=G_COSTS)
float stopAtrBuffer = input.float(0.10, "Marge du stop derrière le sweep (x ATR)", minval=0.01, maxval=1.0, step=0.01, group=G_COSTS)
float maxStopAtr = input.float(3.0, "Stop maximal (x ATR)", minval=0.5, maxval=10.0, step=0.25, group=G_COSTS)
float simulatedQty = input.float(1.0, "Quantité Strategy Tester", minval=0.001, step=0.01, group=G_COSTS,
     tooltip="Quantité de simulation TradingView. Vérifie l'unité et le contrat XAUUSD de ton courtier avant toute utilisation.")

bool showLiquidity = input.bool(true, "Afficher les niveaux balayables", group=G_VIEW)
bool showFvg = input.bool(true, "Afficher la FVG active", group=G_VIEW)
bool showOrders = input.bool(true, "Afficher entrée, stop et cible", group=G_VIEW)
bool showSignals = input.bool(true, "Afficher les étapes du scénario", group=G_VIEW)
string panelMode = input.string("Mobile", "Panneau", options=["Mobile", "Détaillé"], group=G_VIEW)

bool isM5 = timeframe.isminutes and timeframe.multiplier == 5
if barstate.isfirst and not isM5
    runtime.error("KRONOS XAUUSD R1 fonctionne sur un graphique 5 minutes (M5).")

bool isXau = str.contains(str.upper(syminfo.ticker), "XAU")
float atr = ta.atr(atrLength)
float priorHigh = ta.highest(high[1], sweepLookback)
float priorLow = ta.lowest(low[1], sweepLookback)
float swingHigh = ta.highest(high[1], bosLookback)
float swingLow = ta.lowest(low[1], bosLookback)
float candleRange = math.max(high - low, syminfo.mintick)
float candleBody = math.abs(close - open)

// Valeurs M15 tirées de bougies clôturées uniquement, sans lecture anticipée.
[m15Close, m15Ema20, m15Ema50, m15Ema20TwoBarsAgo] = request.security(
     syminfo.tickerid, "15",
     [close[1], ta.ema(close, 20)[1], ta.ema(close, 50)[1], ta.ema(close, 20)[3]],
     gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
bool m15Bull = m15Close > m15Ema20 and m15Ema20 > m15Ema50 and m15Ema20 > m15Ema20TwoBarsAgo
bool m15Bear = m15Close < m15Ema20 and m15Ema20 < m15Ema50 and m15Ema20 < m15Ema20TwoBarsAgo
string m15Text = m15Bull ? "HAUSSIER" : m15Bear ? "BAISSIER" : "NEUTRE / MIXTE"

int closeHourUtc = hour(time_close, TZ)
int closeDayUtc = dayofweek(time_close, TZ)
bool weekdayUtc = closeDayUtc >= dayofweek.monday and closeDayUtc <= dayofweek.friday
bool inTradeHours = not useSession or (weekdayUtc and closeHourUtc >= 7 and closeHourUtc < 17)
bool m15AllowsLong = not useM15Filter or m15Bull
bool m15AllowsShort = not useM15Filter or m15Bear

// State machine: sweep/reclaim → displacement + FVG → first confirmed midpoint retest.
var int sweepDirection = 0
var int sweepBar = na
var float sweepExtreme = na
var float sweptLevel = na
var int fvgDirection = 0
var int fvgBar = na
var float fvgLower = na
var float fvgUpper = na
var float fvgMid = na
var float plannedStop = na
var float plannedEntry = na
var float plannedTarget = na
var int positionEntryBar = na
var int pendingDirection = 0
var box activeFvgBox = na
var string lastEvent = "AUCUN SETUP"

bool bullSweep = barstate.isconfirmed and inTradeHours and not na(priorLow)
     and low < priorLow and close > priorLow and m15AllowsLong
bool bearSweep = barstate.isconfirmed and inTradeHours and not na(priorHigh)
     and high > priorHigh and close < priorHigh and m15AllowsShort

if barstate.isconfirmed
    // Cancel a sweep if it expires or price takes its extreme again before displacement.
    if sweepDirection != 0 and (bar_index - sweepBar > sweepWaitBars
         or (sweepDirection == 1 and low <= sweepExtreme)
         or (sweepDirection == -1 and high >= sweepExtreme))
        sweepDirection := 0
        sweepBar := na
        sweepExtreme := na
        sweptLevel := na

    // Cancel an unfilled FVG if invalidated or expired.
    if fvgDirection != 0 and (bar_index - fvgBar > fvgRetestBars
         or (fvgDirection == 1 and low <= plannedStop)
         or (fvgDirection == -1 and high >= plannedStop))
        fvgDirection := 0
        fvgBar := na
        fvgLower := na
        fvgUpper := na
        fvgMid := na
        plannedStop := na
        plannedStop := na
        if not na(activeFvgBox)
            box.delete(activeFvgBox)
            activeFvgBox := na
        lastEvent := "FVG ANNULÉE / EXPIRÉE"

    bool bullDisplacement = close > open and candleBody >= atr * displacementAtr
         and close > swingHigh and low > high[2] and close >= low + candleRange * 0.75
    bool bearDisplacement = close < open and candleBody >= atr * displacementAtr
         and close < swingLow and high < low[2] and close <= high - candleRange * 0.75

    if fvgDirection == 0 and sweepDirection == 1 and bar_index > sweepBar and m15AllowsLong and bullDisplacement
        fvgDirection := 1
        fvgBar := bar_index
        fvgLower := high[2]
        fvgUpper := low
        fvgMid := (fvgLower + fvgUpper) / 2.0
        plannedStop := sweepExtreme - math.max(atr * stopAtrBuffer, 2 * syminfo.mintick)
        sweepDirection := 0
        sweepBar := na
        lastEvent := "DISPLACEMENT HAUSSIER + FVG"
        if not na(activeFvgBox)
            box.delete(activeFvgBox)
        if showFvg
            activeFvgBox := box.new(bar_index - 2, fvgUpper, bar_index + 1, fvgLower,
                 border_color=color.new(color.lime, 0), bgcolor=color.new(color.lime, 84),
                 extend=extend.right, text="FVG LONG · attendre 50%", text_color=color.lime,
                 text_size=size.small)
        label.new(bar_index, low, "BOS + FVG\nattendre retest 50%", style=label.style_label_up,
             color=color.new(color.green, 0), textcolor=color.white, size=size.small)
        alert("KRONOS XAU | Displacement haussier + FVG créée | attendre le retest | " + syminfo.ticker,
             alert.freq_once_per_bar_close)
    else if fvgDirection == 0 and sweepDirection == -1 and bar_index > sweepBar and m15AllowsShort and bearDisplacement
        fvgDirection := -1
        fvgBar := bar_index
        fvgLower := high
        fvgUpper := low[2]
        fvgMid := (fvgLower + fvgUpper) / 2.0
        plannedStop := sweepExtreme + math.max(atr * stopAtrBuffer, 2 * syminfo.mintick)
        sweepDirection := 0
        sweepBar := na
        lastEvent := "DISPLACEMENT BAISSIER + FVG"
        if not na(activeFvgBox)
            box.delete(activeFvgBox)
        if showFvg
            activeFvgBox := box.new(bar_index - 2, fvgUpper, bar_index + 1, fvgLower,
                 border_color=color.new(color.red, 0), bgcolor=color.new(color.red, 84),
                 extend=extend.right, text="FVG SHORT · attendre 50%", text_color=color.red,
                 text_size=size.small)
        label.new(bar_index, high, "BOS + FVG\nattendre retest 50%", style=label.style_label_down,
             color=color.new(color.red, 0), textcolor=color.white, size=size.small)
        alert("KRONOS XAU | Displacement baissier + FVG créée | attendre le retest | " + syminfo.ticker,
             alert.freq_once_per_bar_close)

bool longSignal = false
bool shortSignal = false
float costEstimate = spreadEstimateUsd + 2.0 * slippageTicks * syminfo.mintick + roundTripCommissionUsd
if barstate.isconfirmed and fvgDirection != 0 and bar_index > fvgBar and inTradeHours and strategy.position_size == 0
    bool midpointTouched = low <= fvgMid and high >= fvgMid
    bool bullRetest = fvgDirection == 1 and midpointTouched and close > fvgMid and close > open
    bool bearRetest = fvgDirection == -1 and midpointTouched and close < fvgMid and close < open
    float longRisk = close - plannedStop
    float shortRisk = plannedStop - close
    bool longRiskOk = longRisk > 0 and longRisk <= atr * maxStopAtr and costEstimate / longRisk <= maxCostR
    bool shortRiskOk = shortRisk > 0 and shortRisk <= atr * maxStopAtr and costEstimate / shortRisk <= maxCostR
    longSignal := bullRetest and longRiskOk and m15AllowsLong and isXau
    shortSignal := bearRetest and shortRiskOk and m15AllowsShort and isXau
    if longSignal
        pendingDirection := 1
        plannedEntry := close
        plannedTarget := plannedEntry + longRisk * targetR
        strategy.entry("K-XAU-L", strategy.long, qty=simulatedQty, comment="Retest FVG long")
        strategy.exit("K-XAU-L-X", from_entry="K-XAU-L", stop=plannedStop, limit=plannedTarget)
        lastEvent := "ACHAT · retest FVG confirmé"
        fvgDirection := 0
        fvgBar := na
        if not na(activeFvgBox)
            box.delete(activeFvgBox)
            activeFvgBox := na
        alert("KRONOS XAU | ACHAT conditionnel | entrée≈" + str.tostring(plannedEntry, format.mintick)
             + " | SL=" + str.tostring(plannedStop, format.mintick)
             + " | TP=" + str.tostring(plannedTarget, format.mintick), alert.freq_once_per_bar_close)
    else if shortSignal
        pendingDirection := -1
        plannedEntry := close
        plannedTarget := plannedEntry - shortRisk * targetR
        strategy.entry("K-XAU-S", strategy.short, qty=simulatedQty, comment="Retest FVG short")
        strategy.exit("K-XAU-S-X", from_entry="K-XAU-S", stop=plannedStop, limit=plannedTarget)
        lastEvent := "VENTE · retest FVG confirmé"
        fvgDirection := 0
        fvgBar := na
        if not na(activeFvgBox)
            box.delete(activeFvgBox)
            activeFvgBox := na
        alert("KRONOS XAU | VENTE conditionnelle | entrée≈" + str.tostring(plannedEntry, format.mintick)
             + " | SL=" + str.tostring(plannedStop, format.mintick)
             + " | TP=" + str.tostring(plannedTarget, format.mintick), alert.freq_once_per_bar_close)

// Record the first filled chart bar, then apply the time stop.
if strategy.position_size != 0 and strategy.position_size[1] == 0
    positionEntryBar := bar_index
    pendingDirection := 0
    lastEvent := strategy.position_size > 0 ? "POSITION LONG ACTIVE" : "POSITION SHORT ACTIVE"
    plannedEntry := strategy.position_avg_price
    if strategy.position_size > 0 and plannedStop < plannedEntry
        plannedTarget := plannedEntry + (plannedEntry - plannedStop) * targetR
        strategy.exit("K-XAU-L-X", from_entry="K-XAU-L", stop=plannedStop, limit=plannedTarget)
    else if strategy.position_size < 0 and plannedStop > plannedEntry
        plannedTarget := plannedEntry - (plannedStop - plannedEntry) * targetR
        strategy.exit("K-XAU-S-X", from_entry="K-XAU-S", stop=plannedStop, limit=plannedTarget)
if strategy.position_size == 0 and strategy.position_size[1] != 0
    positionEntryBar := na
    pendingDirection := 0
    plannedEntry := na
    plannedTarget := na
    plannedStop := na
    lastEvent := "TRADE CLOS · ATTENDRE NOUVEAU SWEEP"
if strategy.position_size != 0 and not na(positionEntryBar) and bar_index - positionEntryBar >= maxHoldBars - 1
    if strategy.position_size > 0
        strategy.close("K-XAU-L", comment="Sortie temps")
    else
        strategy.close("K-XAU-S", comment="Sortie temps")

// Start a new sweep watch only after the preceding sequence is cleared.
if barstate.isconfirmed and strategy.position_size == 0 and fvgDirection == 0 and sweepDirection == 0
     and not longSignal and not shortSignal and inTradeHours and isXau
    if bullSweep
        sweepDirection := 1
        sweepBar := bar_index
        sweepExtreme := low
        sweptLevel := priorLow
        lastEvent := "SWEEP BAS · attendre BOS + FVG"
        label.new(bar_index, low, "SWEEP LOW\nattendre displacement", style=label.style_label_up,
             color=color.new(color.teal, 0), textcolor=color.white, size=size.small)
        alert("KRONOS XAU | Sweep du bas confirmé | attendre displacement + FVG | " + syminfo.ticker,
             alert.freq_once_per_bar_close)
    else if bearSweep
        sweepDirection := -1
        sweepBar := bar_index
        sweepExtreme := high
        sweptLevel := priorHigh
        lastEvent := "SWEEP HAUT · attendre BOS + FVG"
        label.new(bar_index, high, "SWEEP HIGH\nattendre displacement", style=label.style_label_down,
             color=color.new(color.orange, 0), textcolor=color.white, size=size.small)
        alert("KRONOS XAU | Sweep du haut confirmé | attendre displacement + FVG | " + syminfo.ticker,
             alert.freq_once_per_bar_close)

if fvgDirection != 0 and not na(activeFvgBox)
    box.set_right(activeFvgBox, bar_index + 1)

plot(showLiquidity ? priorHigh : na, "Liquidité récente · haut", color=color.new(color.red, 35), linewidth=1, style=plot.style_linebr)
plot(showLiquidity ? priorLow : na, "Liquidité récente · bas", color=color.new(color.aqua, 35), linewidth=1, style=plot.style_linebr)
plot(showLiquidity and sweepDirection != 0 ? sweptLevel : na, "Niveau balayé", color=color.yellow, linewidth=2, style=plot.style_linebr)
plot(showOrders and strategy.position_size != 0 ? plannedStop : na, "Invalidation", color=color.red, linewidth=2, style=plot.style_linebr)
plot(showOrders and strategy.position_size != 0 ? plannedTarget : na, "Objectif", color=color.lime, linewidth=2, style=plot.style_linebr)
plotshape(showSignals and longSignal, title="Achat après retest FVG", style=shape.labelup, location=location.belowbar,
     color=color.lime, text="LONG\nFVG", textcolor=color.black, size=size.small)
plotshape(showSignals and shortSignal, title="Vente après retest FVG", style=shape.labeldown, location=location.abovebar,
     color=color.red, text="SHORT\nFVG", textcolor=color.white, size=size.small)

var table panel = table.new(position.top_right, 2, 8, frame_color=color.new(color.silver, 40), frame_width=1,
     border_color=color.new(color.silver, 75), border_width=1)
if barstate.islast
    string setupText = strategy.position_size > 0 ? "POSITION LONG"
         : strategy.position_size < 0 ? "POSITION SHORT"
         : pendingDirection == 1 ? "ORDRE LONG EN ATTENTE"
         : pendingDirection == -1 ? "ORDRE SHORT EN ATTENTE"
         : fvgDirection == 1 ? "ATTENDRE RETEST FVG LONG"
         : fvgDirection == -1 ? "ATTENDRE RETEST FVG SHORT"
         : sweepDirection == 1 ? "ATTENDRE BOS + FVG LONG"
         : sweepDirection == -1 ? "ATTENDRE BOS + FVG SHORT"
         : "ATTENDRE UN SWEEP"
    string trendCheck = m15Bull ? "M15 HAUSSIER" : m15Bear ? "M15 BAISSIER" : "M15 NEUTRE"
    string zoneText = fvgDirection != 0 ? str.tostring(fvgLower, format.mintick) + " – " + str.tostring(fvgUpper, format.mintick) : "—"
    string invalidationText = not na(plannedStop) ? str.tostring(plannedStop, format.mintick) : "Après displacement"
    string targetText = not na(plannedTarget) ? str.tostring(plannedTarget, format.mintick) : "1,5R depuis entrée prévue"
    string costText = not na(plannedStop) ? str.tostring(costEstimate / math.max(math.abs(close - plannedStop), syminfo.mintick), "#.##") + "R" : "Estimé " + str.tostring(costEstimate, "#.##") + "$"
    color stateColor = strategy.position_size != 0 ? color.new(color.blue, 25)
         : fvgDirection != 0 ? color.new(color.green, 35)
         : sweepDirection != 0 ? color.new(color.orange, 28) : color.new(color.gray, 55)
    table.cell(panel, 0, 0, "KRONOS XAU R1", bgcolor=color.new(color.black, 0), text_color=color.white)
    table.cell(panel, 1, 0, isXau ? syminfo.ticker : "CHART NON-XAU", bgcolor=color.new(color.black, 0), text_color=isXau ? color.white : color.orange)
    table.cell(panel, 0, 1, "SCÉNARIO", text_color=color.white)
    table.cell(panel, 1, 1, setupText, bgcolor=stateColor, text_color=color.white)
    table.cell(panel, 0, 2, "CONTEXTE M15", text_color=color.white)
    table.cell(panel, 1, 2, trendCheck + (useM15Filter ? " · FILTRE ON" : " · INFO"), text_color=m15Bull ? color.lime : m15Bear ? color.red : color.silver)
    table.cell(panel, 0, 3, "NIVEAU BALAYÉ", text_color=color.white)
    table.cell(panel, 1, 3, not na(sweptLevel) ? str.tostring(sweptLevel, format.mintick) : "H/L " + str.tostring(sweepLookback) + " M5", text_color=color.yellow)
    table.cell(panel, 0, 4, "ZONE FVG", text_color=color.white)
    table.cell(panel, 1, 4, zoneText, text_color=color.aqua)
    table.cell(panel, 0, 5, "INVALIDATION", text_color=color.white)
    table.cell(panel, 1, 5, invalidationText, text_color=color.red)
    table.cell(panel, 0, 6, "CIBLE / COÛT", text_color=color.white)
    table.cell(panel, 1, 6, targetText + " · coût≈" + costText, text_color=color.lime)
    table.cell(panel, 0, 7, panelMode == "Mobile" ? "COÛTS" : "ÉTAT / HORAIRES", text_color=color.white)
    table.cell(panel, 1, 7, panelMode == "Mobile" ? "M5 · UTC 07-17 · spread filtre seul, P&L brut"
         : lastEvent + (inTradeHours ? " · fenêtre active" : " · hors fenêtre"), text_color=color.silver)
